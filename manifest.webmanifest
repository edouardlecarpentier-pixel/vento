{
  "name": "Vento — Planificateur vélo",
  "short_name": "Vento",
  "description": "Trajets vélo avec vent, pistes cyclables, vélo-taf, dénivelé, POI et entraînement. Export GPX.",
  "id": "./index.html",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0e13",
  "theme_color": "#0a0e13",
  "lang": "fr",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "gpx", "accept": ["application/gpx+xml", ".gpx", "application/octet-stream", "text/xml", "application/xml"] }] }
  },
  "shortcuts": [
    { "name": "Entraînement", "url": "./training.html" }
  ]
}
